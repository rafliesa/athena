{
  "name": "athena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A terminal UI built with Ink and React",
  "bin": {
    "athena": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "execa": "^10.0.0",
    "ink-testing-library": "^4.0.0",
    "memfs": "^4.64.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
